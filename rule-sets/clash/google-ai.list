# Google AI 分流规则（Gemini / Antigravity / AI Studio / DeepMind / NotebookLM / Cloud Code）
# 适用：Clash Meta(mihomo) rule-provider / Stash / Shadowrocket 等
# 格式：classical text（每行 类型,值）
# 用法示例（mihomo）:
#   rule-providers:
#     google-ai:
#       type: http
#       behavior: classical
#       format: text
#       url: https://raw.githubusercontent.com/peanutgao/my-proxy-configs/main/rule-sets/clash/google-ai.list
#       path: ./ruleset/my-proxy-configs/google-ai.list
#       interval: 86400
#   rules:
#     - RULE-SET,google-ai,你的AI策略组
# 注意：GEOSITE,google-gemini 需 mihomo / Stash(geosite 数据)；Shadowrocket 不支持时请改用 shadowrocket/Gemini.list
DOMAIN-SUFFIX,gemini.google.com
DOMAIN,bard.google.com
DOMAIN-SUFFIX,aistudio.google.com
DOMAIN,notebooklm.google.com
DOMAIN,labs.google
DOMAIN-SUFFIX,ai.google.dev
DOMAIN-SUFFIX,generativeai.google
DOMAIN-SUFFIX,generativelanguage.googleapis.com
DOMAIN-SUFFIX,alkalimakersuite-pa.clients6.google.com
DOMAIN,proactivebackend-pa.googleapis.com
DOMAIN,aiplatform.googleapis.com
DOMAIN-SUFFIX,deepmind.com
DOMAIN-SUFFIX,deepmind.google
DOMAIN-SUFFIX,antigravity.google
DOMAIN-SUFFIX,antigravity-unleash.goog
DOMAIN,antigravity-pa.googleapis.com
DOMAIN,antigravity.googleapis.com
DOMAIN,cloudcode-pa.googleapis.com
DOMAIN,daily-cloudcode-pa.googleapis.com
DOMAIN,daily-cloudcode-pa.sandbox.googleapis.com
DOMAIN,autopush-cloudcode-pa.sandbox.googleapis.com
DOMAIN,cloudaicompanion.googleapis.com
# Antigravity 补齐（2026-11-28，对照 AirRules/官方文档/实测）：
# antigravity.google 后缀盖不住 .google.com（解析到不同 IP）
DOMAIN,antigravity.google.com
# IDE/CLI/Hub 自动更新（Cloud Run）
DOMAIN,antigravity-cli-auto-updater-974169037036.us-central1.run.app
DOMAIN,antigravity-ide-auto-updater-974169037036.us-central1.run.app
DOMAIN,antigravity-hub-auto-updater-974169037036.us-central1.run.app
# 内部全双工 relay（流式输出靠它）
DOMAIN,jetski-webchannel.googleapis.com
# Cloud Code 家族：子域变体（DOMAIN-SUFFIX 点锚定盖不住 daily-/autopush- 前缀变体）
DOMAIN,cloudcode-pa.sandbox.googleapis.com
DOMAIN,daily-cloudcode-pa.sandbox.googleapis.com
DOMAIN,aicode-experiments.googleapis.com
DOMAIN,cloudcode-experiments.googleapis.com
# IDE 功能组件（记忆/语音/主动建议/tailwind）
DOMAIN,geller-pa.googleapis.com
DOMAIN,robinfrontend-pa.googleapis.com
DOMAIN,labstailwind.pa.googleapis.com
DOMAIN,aisandbox-pa.googleapis.com
DOMAIN,notebooklm-pa.googleapis.com
# Gemini 网页客户端通道
DOMAIN,geminiweb-pa.clients.google.com
DOMAIN,geminiweb-pa.clients6.google.com
DOMAIN,alkalicore-pa.clients6.google.com
DOMAIN,webchannel-alkalimakersuite-pa.clients6.google.com
DOMAIN,alkalimakersuiteapplets.pa.googleapis.com
# Antigravity CLI 后端（fetch_config / AI Code）
DOMAIN,aicode.googleapis.com
GEOSITE,google-gemini
