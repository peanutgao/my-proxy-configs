# Google AI 分流规则（Gemini / Antigravity / AI Studio / DeepMind / NotebookLM / Cloud Code）
# 适用：Clash Meta(mihomo) rule-provider / Stash / Shadowrocket 等
# 格式：classical text（每行 类型,值）
# 用法示例（mihomo）:
#   rule-providers:
#     google-ai:
#       type: http
#       behavior: classical
#       format: text
#       url: https://raw.githubusercontent.com/peanutgao/my-proxy-configs/main/rule-sets/clash/google-ai.list
#       path: ./ruleset/my-proxy-configs/google-ai.list
#       interval: 86400
#   rules:
#     - RULE-SET,google-ai,你的AI策略组
# 注意：GEOSITE,google-gemini 需 mihomo / Stash(geosite 数据)；Shadowrocket 不支持时请改用 shadowrocket/Gemini.list
DOMAIN-SUFFIX,gemini.google.com
DOMAIN,bard.google.com
DOMAIN-SUFFIX,aistudio.google.com
DOMAIN,notebooklm.google.com
DOMAIN,labs.google
DOMAIN-SUFFIX,ai.google.dev
DOMAIN-SUFFIX,generativeai.google
DOMAIN-SUFFIX,generativelanguage.googleapis.com
DOMAIN-SUFFIX,alkalimakersuite-pa.clients6.google.com
DOMAIN,proactivebackend-pa.googleapis.com
DOMAIN,aiplatform.googleapis.com
DOMAIN-SUFFIX,deepmind.com
DOMAIN-SUFFIX,deepmind.google
DOMAIN-SUFFIX,antigravity.google
DOMAIN-SUFFIX,antigravity-unleash.goog
DOMAIN,antigravity-pa.googleapis.com
DOMAIN,antigravity.googleapis.com
DOMAIN,cloudcode-pa.googleapis.com
DOMAIN,daily-cloudcode-pa.googleapis.com
DOMAIN,daily-cloudcode-pa.sandbox.googleapis.com
DOMAIN,autopush-cloudcode-pa.sandbox.googleapis.com
DOMAIN,cloudaicompanion.googleapis.com
# 2026-11-23: Gemini API 反代（Cloudflare Worker，绕开出口 IP 地区判定）。
# 应用侧 base URL 用 https://gemini-proxy.joseph0750.workers.dev/v1beta
DOMAIN-SUFFIX,joseph0750.workers.dev
GEOSITE,google-gemini
